auto-install-peers=false
strict-peer-dependencies=false
# Replit's build image ships pnpm 10.x. Left to itself it tries to self-install the
# pnpm@11.8.0 pinned in package.json and Node 24 aborts on a worker-thread assertion
# in the build sandbox, failing every publish (2026-09-03). The pin stays for corepack
# users locally; on Replit pnpm just runs as the version already on PATH.
manage-package-manager-versions=false
